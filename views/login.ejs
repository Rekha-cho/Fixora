<%- include('partials/head') %>

    <div class="auth-page">
        <div class="auth-left">
            <div class="brand" style="color: white; margin-bottom: 2rem;">
                <i data-lucide="graduation-cap" size="48"></i>
                <h1 style="font-size: 2.5rem;">Fixora</h1>
            </div>
            <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Your Voice <span
                    style="color: var(--accent);">Matters.</span></h2>
            <p style="font-size: 1.1rem; opacity: 0.8; margin-bottom: 2.5rem;">
                A centralized platform designed to bridge the gap between students and administration — making complaint
                resolution fast, transparent, and hassle-free.
            </p>

            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="background: rgba(255,255,255,0.1); padding: 0.75rem; border-radius: var(--radius-md);">
                        <i data-lucide="check-circle" style="color: var(--accent);"></i>
                    </div>
                    <div>
                        <strong style="display: block;">Easy Submission</strong>
                        <span style="font-size: 0.9rem; opacity: 0.7;">Report issues in seconds</span>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="background: rgba(255,255,255,0.1); padding: 0.75rem; border-radius: var(--radius-md);">
                        <i data-lucide="clock" style="color: var(--accent);"></i>
                    </div>
                    <div>
                        <strong style="display: block;">Real-time Tracking</strong>
                        <span style="font-size: 0.9rem; opacity: 0.7;">Stay updated on your status</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-right">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <h2 style="font-size: 1.75rem; font-weight: 700;">Welcome Back</h2>
                    <p style="color: var(--text-muted);">Log in to access your portal</p>
                </div>

                <div class="msg" id="msg"></div>

                <div style="display: flex; gap: 0.75rem; margin-bottom: 2rem;">
                    <button id="roleStudent" class="btn"
                        style="background: white; border: 1px solid var(--border); color: var(--text-muted);"
                        onclick="setRole('student')">Student</button>
                    <button id="roleAdmin" class="btn"
                        style="background: white; border: 1px solid var(--border); color: var(--text-muted);"
                        onclick="setRole('admin')">Admin</button>
                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" id="email" placeholder="you@college.edu" />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-container">
                        <input type="password" id="password" placeholder="••••••••" />
                        <button class="password-toggle">
                            <i data-lucide="eye"></i>
                        </button>
                    </div>
                </div>

                <button class="btn btn-primary" onclick="handleLogin()">
                    <span>Login</span>
                    <i data-lucide="arrow-right" size="18"></i>
                </button>

                <p class="text-center mt-4" style="font-size: 0.9rem; color: var(--text-muted);">
                    New here? <a href="/signup"
                        style="color: var(--primary); font-weight: 600; text-decoration: none;">Create an account</a>
                </p>
            </div>
        </div>
    </div>

    <script>
        let selectedRole = 'student';

        function setRole(role) {
            selectedRole = role;
            const sBtn = document.getElementById('roleStudent');
            const aBtn = document.getElementById('roleAdmin');

            if (role === 'student') {
                sBtn.style.background = 'var(--primary)';
                sBtn.style.color = 'white';
                sBtn.style.borderColor = 'var(--primary)';
                aBtn.style.background = 'white';
                aBtn.style.color = 'var(--text-muted)';
                aBtn.style.borderColor = 'var(--border)';
            } else {
                aBtn.style.background = 'var(--primary)';
                aBtn.style.color = 'white';
                aBtn.style.borderColor = 'var(--primary)';
                sBtn.style.background = 'white';
                sBtn.style.color = 'var(--text-muted)';
                sBtn.style.borderColor = 'var(--border)';
            }
        }

        // Initialize default state
        setRole('student');

        async function handleLogin() {
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value.trim();

            if (!email || !password) {
                showMsg('⚠️ Please fill all fields!', 'error');
                return;
            }

            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password, role: selectedRole })
            });

            const data = await res.json();

            if (res.ok) {
                localStorage.setItem('user', JSON.stringify({
                    ...data.user,
                    token: data.token
                }));
                showMsg('✅ Login successful! Redirecting...', 'success');

                setTimeout(() => {
                    const role = data.user.role ? data.user.role.toLowerCase() : 'student';
                    if (role === 'admin') {
                        window.location.href = '/admin';
                    } else {
                        window.location.href = '/';
                    }
                }, 1500);
            } else {
                showMsg('❌ ' + data.message, 'error');
            }
        }
    </script>

    <%- include('partials/footer') %>