<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container">
    <div class="flex-between mb-4" style="margin-top: 2rem;">
        <h2 style="font-weight: 800; font-size: 2rem;">System Analytics</h2>
        <div style="background: var(--surface); padding: 0.5rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); font-size: 0.9rem; color: var(--text-muted);">
            <i data-lucide="refresh-cw" size="14"></i>
            <span>Real-time data</span>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-num" id="total">0</div>
            <div class="stat-label">Total Complaints</div>
        </div>
        <div class="stat-card">
            <div class="stat-num" id="pending" style="color: var(--warning);">0</div>
            <div class="stat-label">Pending</div>
        </div>
        <div class="stat-card">
            <div class="stat-num" id="progress" style="color: var(--primary);">0</div>
            <div class="stat-label">In Progress</div>
        </div>
        <div class="stat-card">
            <div class="stat-num" id="resolved" style="color: var(--success);">0</div>
            <div class="stat-label">Resolved</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; margin-top: 2rem;">
        <div class="card">
            <h3 class="card-title">
                <i data-lucide="pie-chart" style="color: var(--primary);"></i>
                <span>Category Distribution</span>
            </h3>
            <div id="categoryList" style="display: flex; flex-direction: column; gap: 1rem;">
                <!-- Categories will be injected here -->
            </div>
        </div>

        <div class="card">
            <h3 class="card-title">
                <i data-lucide="trending-up" style="color: var(--primary);"></i>
                <span>Resolution Metrics</span>
            </h3>
            <div id="metrics" style="display: flex; flex-direction: column; gap: 1rem;">
                <div class="flex-between" style="padding: 1rem; background: #f8fafc; border-radius: var(--radius-md);">
                    <span>Resolution Rate</span>
                    <span id="resRate" style="font-weight: 700; color: var(--success);">0%</span>
                </div>
                <div class="flex-between" style="padding: 1rem; background: #f8fafc; border-radius: var(--radius-md);">
                    <span>Pending Rate</span>
                    <span id="pendRate" style="font-weight: 700; color: var(--warning);">0%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const user = JSON.parse(localStorage.getItem('user'));
    if (!user || user.role !== 'admin') window.location.href = '/login';

    loadAnalytics();

    async function loadAnalytics() {
        const res = await fetch('/api/complaints', {
            headers: { Authorization: 'Bearer ' + user.token }
        });

        const complaints = await res.json();
        const total = complaints.length;
        const pending = complaints.filter(c => c.status === 'Pending').length;
        const progress = complaints.filter(c => c.status === 'In Progress').length;
        const resolved = complaints.filter(c => c.status === 'Resolved').length;

        document.getElementById('total').textContent = total;
        document.getElementById('pending').textContent = pending;
        document.getElementById('progress').textContent = progress;
        document.getElementById('resolved').textContent = resolved;

        if (total > 0) {
            document.getElementById('resRate').textContent = Math.round((resolved / total) * 100) + '%';
            document.getElementById('pendRate').textContent = Math.round((pending / total) * 100) + '%';
        }

        const categories = {};
        complaints.forEach(c => {
            categories[c.category] = (categories[c.category] || 0) + 1;
        });

        const list = document.getElementById('categoryList');
        list.innerHTML = Object.keys(categories).map(cat => {
            const count = categories[cat];
            const percentage = Math.round((count / total) * 100);
            return `
                <div>
                    <div class="flex-between mb-4" style="font-size: 0.9rem;">
                        <span style="font-weight: 600;">${cat}</span>
                        <span style="color: var(--text-muted);">${count} complaints (${percentage}%)</span>
                    </div>
                    <div style="height: 8px; background: var(--border); border-radius: 4px; overflow: hidden;">
                        <div style="height: 100%; background: var(--primary); width: ${percentage}%"></div>
                    </div>
                </div>
            `;
        }).join('');
    }
</script>

<%- include('partials/footer') %>
